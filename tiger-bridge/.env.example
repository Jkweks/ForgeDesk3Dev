# Port this bridge service listens on (Laravel's TIGER_BRIDGE_URL should point here)
BRIDGE_PORT=9111

# Long-lived shared secret. Every request must send it as
# "Authorization: Bearer <token>" or the bridge rejects it — this is what
# stops any other device on the shop LAN from moving the saw. Generate one
# with `openssl rand -hex 32` and set the same value as TIGER_BRIDGE_TOKEN
# in ForgeDesk's .env. The service refuses to start without this set.
BRIDGE_TOKEN=17a0e42aedcdfeb595ed5be71bc8b391c7cdca6dd70bca38b315825f4ef9c4bf

# Second, independent layer on top of BRIDGE_TOKEN: comma-separated list of
# IPs and/or IPv4 CIDR ranges allowed to call this bridge at all, checked
# before the token. The only caller in this deployment is the ForgeDesk app
# server itself — set this to that host's LAN IP (e.g. 192.168.1.50, or
# 192.168.1.50/32) once it's known. Leave blank to skip this layer (token
# alone still applies) — not recommended once the app server's IP is fixed.
ALLOWED_CLIENT_IPS=

# TigerStop serial connection — TigerSET must be enabled on the amp
SERIAL_PORT=COM3
BAUD_RATE=57600

# Zebra printer — raw ZPL over TCP port 9100
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
