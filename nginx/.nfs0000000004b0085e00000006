server {
    listen 80;
    server_name localhost;
    root /var/www/html/public;
    index index.php index.html;
    charset utf-8;

    # Serve uploaded files directly from the storage directory,
    # bypassing the public/storage symlink which uses a host-absolute path
    # that is unreachable inside the Docker containers.
    location /storage/ {
        alias /var/www/html/storage/app/public/;
        # Uploaded files are data, never pages: no sniffing, no inline scripts.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox" always;
    }

    # Never execute or serve script-like uploads, whatever the extension check missed.
    location ~* ^/storage/.*\.(php[0-9]*|phtml|phar|html?|xhtml|svgz?|xml)$ {
        return 403;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;

        # Timeouts for large file processing
        fastcgi_read_timeout 600;
        fastcgi_send_timeout 600;
        fastcgi_connect_timeout 600;

        # Pass proxy headers from nginx proxy manager to Laravel
        # APPEND the real peer address instead of passing the caller's header
        # through verbatim, so Laravel (which trusts only private-range proxies,
        # see bootstrap/app.php) resolves the client from the right-hand side
        # and a spoofed X-Forwarded-For can't pick its own IP.
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_param HTTP_X_FORWARDED_HOST $http_x_forwarded_host;
        fastcgi_param HTTP_X_FORWARDED_PORT $http_x_forwarded_port;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_param HTTP_X_FORWARDED_PREFIX $http_x_forwarded_prefix;
        fastcgi_param HTTPS $https if_not_empty;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    client_max_body_size 50M;
}
