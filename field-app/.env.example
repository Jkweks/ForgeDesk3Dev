# Copy to .env and fill in. Generate passwords with:  openssl rand -base64 24 | tr -d '/+='

# Superuser, used only inside the db container (init + admin). Never give this to ForgeDesk.
POSTGRES_PASSWORD=

# Role the app uses.
FIELD_APP_DB_PASSWORD=

# Role ForgeDesk uses (FIELDSYNC_DB_PASSWORD on the ForgeDesk side).
FORGEDESK_SYNC_DB_PASSWORD=

# Public hostname for automatic HTTPS, e.g. field.example.com
FIELD_DOMAIN=field.example.com

# Where Postgres listens for ForgeDesk. Use this server's LAN/VPN IP, then firewall port
# FIELDSYNC_DB_PORT to ForgeDesk's address only. 127.0.0.1 = this machine only.
FIELDSYNC_DB_BIND=127.0.0.1
FIELDSYNC_DB_PORT=5432

# Proxy ports (change only if 80/443 are taken).
HTTP_PORT=80
HTTPS_PORT=443

# Only set false for a plain-HTTP local test.
COOKIE_SECURE=true
SESSION_DAYS=30
