.git
.github
*.md

# Docker files not needed in build context
docker-compose*.yml
admin_service/

# Environment / secrets — injected at runtime, never baked into the image
.env
.env.*
1.env
*.env
*.har

# Laravel dev/test artifacts
laravel/.env
laravel/.env.*
laravel/node_modules/
# Never ship the host's dev vendor/ tree — it includes dev-only packages
# (e.g. laravel/pail) from a plain `composer install` on this bind-mounted
# checkout, and COPYing it over the image's own clean `composer install
# --no-dev` output made `composer dump-autoload --no-dev` (which excludes
# dev packages from the autoload map but not from installed.json) fail
# package:discover with "class not found" for that leftover dev package.
laravel/vendor/
laravel/storage/logs/*
laravel/storage/framework/cache/*
laravel/storage/framework/sessions/*
laravel/storage/framework/views/*
# Runtime uploads (job docs, EZ Estimate files, quality report PDFs, work
# order drawings) — served from the app_private volume at runtime, never
# baked into the image. Also unreadable by the host build user (0700, owned
# by uid 82/www-data in the container), which fails the build context send.
laravel/storage/app/private/*
laravel/storage/framework/testing/*
# Cached package/config manifests generated by a dev-time `composer install`
# on the bind-mounted host checkout (includes dev-only packages like
# laravel/pail). Baking these in breaks `composer install --no-dev` +
# `package:discover` in the image, since it expects packages that were never
# installed. Git-ignored for the same reason; always regenerated fresh.
laravel/bootstrap/cache/*.php
laravel/tests/
laravel/.phpunit*

# Scripts not needed in image
scripts/sync-from-prod.sh
