# ForgeDesk Production Environment
# Copy this file to .env and fill in the values before running docker compose.
# Place this .env alongside docker-compose.yml on the VPS.
#
# Generate APP_KEY with:
#   docker compose run --rm app php artisan key:generate --show

APP_NAME=ForgeDesk
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://yourdomain.com

# The external domain(s) allowed to use session cookie auth (comma-separated).
# Must match what the browser sees in the address bar — no protocol, no trailing slash.
# Used by Laravel Sanctum to recognise same-site SPA requests and issue session cookies.
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

# Session — Redis is faster than DB for sessions; ensures auth works across deploys
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Database — used by both the postgres container and the app container
DB_DATABASE=forgedesk
DB_USERNAME=forgedesk
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Redis
REDIS_PASSWORD=null

# Cache / Queue
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE
MAIL_PASSWORD=REPLACE
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=ForgeDesk

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error
