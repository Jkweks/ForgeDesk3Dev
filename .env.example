MAINTENANCE_SECRET=maint_0422
 
 # tiger-bridge runs natively on the shop tablet (COM3), not in this compose
# stack — see docker-compose.yml's note on the "bridge" service.
TIGER_BRIDGE_URL=http://192.168.4.8:9111

# Must match the bridge's BRIDGE_TOKEN (tiger-bridge/.env) — generate with
# `openssl rand -hex 32`. Required whenever TIGER_BRIDGE_FAKE=false; the
# bridge rejects every request without it.
TIGER_BRIDGE_TOKEN=17a0e42aedcdfeb595ed5be71bc8b391c7cdca6dd70bca38b315825f4ef9c4bf

# This app server's own outbound-facing LAN IP, set on the bridge's
# ALLOWED_CLIENT_IPS (tiger-bridge/.env) so it's the only host permitted to
# call the bridge at all. Informational here — nothing on this side reads
# it — but keep it in sync when either IP changes.
# ALLOWED_CLIENT_IPS=192.168.1.50

# The shop tablet's IP — the one device physically wired to the saw and
# running tiger-bridge (see TIGER_BRIDGE_URL above; normally the same host).
# Only requests from this IP are allowed to actually move the saw or fire
# the printer via /cut-station (App\Livewire\CutFlow\Dashboard); every other
# device on the LAN can still view the kiosk page and sign in with a crew
# PIN, but those specific hardware actions no-op for them. Comma-separated,
# IPv4 CIDR allowed. Left blank, every device can command the saw.
CUTFLOW_TABLET_ALLOWED_IPS=

TIGER_BRIDGE_FAKE=false

# CutFlow — absorbed into ForgeDesk in-process (own 'cutflow' Postgres
# database, same server/role as the main DB_* connection above — see
# config/database.php's "cutflow" connection). Only the database name needs
# overriding; host/port/user/password all default to DB_*.
CUTFLOW_DB_DATABASE=cutflow

# --- bridge (only used if bridge runs in this compose stack) ---
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=57600
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
